---
// 記事の date から、GitHub風の草（直近1年）をビルド時に描く
import { getPosts, ymd } from '../lib/site';

const posts = await getPosts();

// 日付ごとの記事
const byDay = new Map<string, string[]>();
for (const p of posts) {
  const k = ymd(p.data.date);
  byDay.set(k, [...(byDay.get(k) ?? []), p.data.title]);
}

// 「今日」は日本時間で決める（ビルド環境はUTCのため）
const DAY = 86_400_000;
const today = new Date(ymd(new Date(Date.now() + 9 * 3600_000)));
// 53週前の日曜日から開始
const start = new Date(today.getTime() - (52 * 7 + today.getUTCDay()) * DAY);

type Cell = { date: string; count: number; titles: string[] } | null;
const weeks: Cell[][] = [];
for (let t = start.getTime(); t <= today.getTime(); t += DAY) {
  const d = new Date(t);
  if (d.getUTCDay() === 0) weeks.push([]);
  const key = ymd(d);
  const titles = byDay.get(key) ?? [];
  weeks[weeks.length - 1].push({ date: key, count: titles.length, titles });
}

// 月ラベル：その週に月の1日が含まれたら表示
const months = weeks.map((w) => {
  const first = w.find((c) => c && c.date.endsWith('-01'));
  return first ? `${Number(first.date.slice(5, 7))}月` : '';
});

const level = (n: number) => (n === 0 ? 0 : n === 1 ? 1 : n === 2 ? 2 : n === 3 ? 3 : 4);
const yearTotal = weeks.flat().reduce((s, c) => s + (c?.count ?? 0), 0);
---
<section class="grass">
  <p class="grass-total">直近1年で <strong>{yearTotal}</strong> 本</p>
  <div class="grass-scroll">
    <div class="grass-months" style={`grid-template-columns: repeat(${weeks.length}, var(--cell))`}>
      {months.map((m) => <span>{m}</span>)}
    </div>
    <div class="grass-grid">
      {weeks.map((w) => (
        <div class="grass-week">
          {w.map((c) =>
            c && (
              <span
                class={`cell l${level(c.count)}`}
                title={c.count ? `${c.date}: ${c.titles.join(' / ')}` : c.date}
              />
            )
          )}
        </div>
      ))}
    </div>
  </div>
</section>
<script>
  // 画面が狭いときは最新（右端）が見えるようにスクロールしておく
  document.querySelectorAll('.grass-scroll').forEach((el) => (el.scrollLeft = el.scrollWidth));
</script>
